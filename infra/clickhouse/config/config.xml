<!-- ==========================================================================
     ClickHouse Custom Configuration
     ========================================================================== -->
<clickhouse>
    <!-- Listen on all interfaces (required for Docker) -->
    <listen_host>0.0.0.0</listen_host>

    <!-- HTTP interface for REST queries and web UI -->
    <http_port>8123</http_port>

    <!-- Native TCP interface (for drivers like clickhouse-go) -->
    <tcp_port>9000</tcp_port>

    <!-- Prometheus metrics endpoint -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>

    <!-- Memory settings -->
    <max_memory_usage>3000000000</max_memory_usage>
    <max_memory_usage_for_all_queries>2500000000</max_memory_usage_for_all_queries>

    <!-- Query settings -->
    <max_query_size>1073741824</max_query_size>
    <max_concurrent_queries>100</max_concurrent_queries>

    <!-- Logging -->
    <logger>
        <level>information</level>
        <console>1</console>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>1000M</size>
        <count>3</count>
    </logger>

    <!-- Data directories -->
    <path>/var/lib/clickhouse/</path>
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>

    <!-- Mark cache for faster aggregations -->
    <mark_cache_size>536870912</mark_cache_size>

    <!-- Disable SSL for internal traffic (Traefik handles SSL) -->
    <openSSL>
        <server>
            <verificationMode>none</verificationMode>
            <loadDefaultCAFile>false</loadDefaultCAFile>
        </server>
    </openSSL>
</clickhouse>
