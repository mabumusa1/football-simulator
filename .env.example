# =============================================================================
# Football Simulator Infrastructure - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# =============================================================================
# DOMAIN & SSL CONFIGURATION (Production)
# =============================================================================
# Your domain name (must point to the Swarm manager's public IP)
DOMAIN=example.com

# Email for Let's Encrypt SSL certificates
LETSENCRYPT_EMAIL=admin@example.com

# =============================================================================
# DOCKER REGISTRY
# =============================================================================
# Leave empty to use local registry on port 5000
# Or set to your registry (e.g., ghcr.io/username, docker.io/username)
REGISTRY=

# Image version tag
VERSION=latest

# =============================================================================
# AUTHENTICATION (Production)
# =============================================================================
# Generate with: htpasswd -nb admin your_password
# Format: username:hashed_password (escape $ as $$ in docker-compose)
TRAEFIK_AUTH=admin:$$apr1$$xyz...

# Basic auth for Prometheus dashboard
PROMETHEUS_AUTH=admin:$$apr1$$xyz...

# Grafana admin password (plain text)
GRAFANA_PASSWORD=change_me_please

# =============================================================================
# API SERVICE
# =============================================================================
# HTTP server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s

# API authentication key (required for protected endpoints)
API_KEY=your-secure-api-key-here

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================
# Kafka bootstrap servers (internal Docker DNS)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Kafka broker address (used in prod docker-compose)
KAFKA_BROKERS=kafka:9092

# Topic configuration
KAFKA_TOPIC_PREFIX=football_simulator
KAFKA_TOPIC_EVENTS=football_simulator.events
KAFKA_TOPIC_RETRY=football_simulator.retry
KAFKA_TOPIC_DEAD=football_simulator.dead

# Producer settings (API service)
KAFKA_PRODUCER_TIMEOUT=10s

# Legacy topic name (used in some prod configs)
KAFKA_TOPIC=api_events
KAFKA_TOPICS=api_events

# Consumer group settings (Consumer service)
KAFKA_GROUP_ID=clickhouse-writer

# =============================================================================
# CLICKHOUSE DATABASE
# =============================================================================
# Connection settings
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=football_simulator
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secure_password

# Used by ClickHouse container
CLICKHOUSE_DB=football_simulator
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# =============================================================================
# CONSUMER SERVICE
# =============================================================================
# Kafka consumer group name
CONSUMER_GROUP=football_simulator-consumers

# Batch processing settings
CONSUMER_BATCH_SIZE=1000
CONSUMER_FLUSH_INTERVAL=5s
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BACKOFF=1s

# Aliases used in prod docker-compose
BATCH_SIZE=1000
FLUSH_INTERVAL=5s

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================
# Admin credentials (dev uses admin/admin)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# User registration
GF_USERS_ALLOW_SIGN_UP=false

# Anonymous access (dev only - disable in production)
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer

# Server settings (production)
GF_SERVER_PROTOCOL=http
GF_SERVER_ROOT_URL=https://grafana.example.com
GF_SECURITY_COOKIE_SECURE=true

# Plugins
GF_INSTALL_PLUGINS=grafana-clickhouse-datasource

# =============================================================================
# KAFKA INTERNAL CONFIGURATION (Docker Container)
# =============================================================================
# KRaft mode settings (no Zookeeper required)
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:29092,CONTROLLER://0.0.0.0:29093,EXTERNAL://0.0.0.0:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,EXTERNAL://localhost:9092
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:29093
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Topic defaults
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_NUM_PARTITIONS=3
KAFKA_LOG_RETENTION_HOURS=168

# =============================================================================
# KAFKA UI (Development)
# =============================================================================
KAFKA_CLUSTERS_0_NAME=football-simulator-local
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=kafka:29092
DYNAMIC_CONFIG_ENABLED=true

# =============================================================================
# K6 LOAD TESTING
# =============================================================================
# Target API URL for load tests
API_URL=http://go-api:8080

# Prometheus remote write for k6 metrics
K6_PROMETHEUS_RW_SERVER_URL=http://prometheus:9090/api/v1/write
K6_PROMETHEUS_RW_PUSH_INTERVAL=5s
K6_PROMETHEUS_RW_TREND_AS_NATIVE_HISTOGRAM=true
