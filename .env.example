# =============================================================================
# Fanfinity Analytics - Environment Configuration Template
# =============================================================================
#
# This file serves as a reference for all environment variables.
# For detailed documentation, see: docs/configuration.md
#
# USAGE:
# 1. In development, the Dev Container auto-configures these values, you can change them from .devcontainer
# 2. In production, we use cloudformation, you can set them up there
# =============================================================================

# -----------------------------------------------------------------------------
# API Service (apps/api)
# Documentation: docs/configuration.md#api-service
# -----------------------------------------------------------------------------

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s

# Authentication (REQUIRED)
API_KEY=your-secure-api-key-here

# Kafka Producer
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_EVENTS=football_simulator.events
KAFKA_TOPIC_ENGAGEMENTS=football_simulator.engagements
KAFKA_PRODUCER_TIMEOUT=10s

# ClickHouse Connection
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=football_simulator
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# Consumer Service (apps/consumer)
# Documentation: docs/configuration.md#consumer-service
# -----------------------------------------------------------------------------

# Kafka Consumer
KAFKA_TOPIC_RETRY=football_simulator.retry
KAFKA_TOPIC_DEAD=football_simulator.dead
CONSUMER_GROUP=football_simulator-consumers

# Event Processing
CONSUMER_BATCH_SIZE=500
CONSUMER_FLUSH_INTERVAL=1s
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BACKOFF=1s
CONSUMER_WORKER_COUNT=2

# High-Volume Engagement Processing
ENGAGEMENT_BATCH_SIZE=5000
ENGAGEMENT_FLUSH_INTERVAL=200ms
ENGAGEMENT_WORKER_COUNT=16

# -----------------------------------------------------------------------------
# Monitoring (Grafana)
# Documentation: docs/configuration.md#grafana
# -----------------------------------------------------------------------------

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# -----------------------------------------------------------------------------
# Production Only (Traefik/SSL)
# Documentation: docs/configuration.md#traefik-production
# -----------------------------------------------------------------------------

# DOMAIN=football.example.com
# LETSENCRYPT_EMAIL=admin@example.com
# TRAEFIK_AUTH=admin:$apr1$...
