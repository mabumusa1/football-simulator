{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start API Server",
      "type": "shell",
      "command": "go run .",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*starting Fanfinity API server.*$",
          "endsPattern": "^.*HTTP server starting.*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      }
    },
    {
      "label": "Start Consumer",
      "type": "shell",
      "command": "go run .",
      "options": {
        "cwd": "${workspaceFolder}/apps/consumer"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*starting.*consumer.*$",
          "endsPattern": "^.*consumer started.*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      }
    },
    {
      "label": "Start All Services",
      "dependsOn": ["Start API Server", "Start Consumer"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
